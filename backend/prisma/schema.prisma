generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id         String   @id @default(cuid())
  roleName   String   @unique
  permission String[]
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  avatar       String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  parentId  String   @default("0-0")
  isShow    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String   @id @default(cuid())
  name      String
  poster    String
  level1    String
  level2    String
  isVip     Boolean  @default(false)
  intro     String
  detail    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  name      String
  img       String
  music     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chart {
  id        String   @id @default(cuid())
  info      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stu {
  id        String   @id @default(cuid())
  name      String
  age       Int
  score     Float
  createdAt DateTime @default(now())
}